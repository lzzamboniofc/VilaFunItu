{
  "name": "villa-fun-itu",
  "version": "1.1.0",
  "private": true,
  "description": "Prévia comercial independente do Villa Fun Itu; código completo preservado.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build-preview.mjs",
    "build:preview": "node scripts/build-preview.mjs",
    "build:completo": "node scripts/build.mjs --modo=publico",
    "build:demo": "node scripts/build.mjs --modo=demonstracao",
    "build:publico": "node scripts/build.mjs --modo=publico",
    "dev": "node scripts/build-preview.mjs && node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "pendencias": "node scripts/pendencias.mjs",
    "marca": "node scripts/gerar-marca.mjs",
    "ilustracoes": "node scripts/gerar-ilustracoes.mjs"
  },
  "optionalDependencies": {
    "esbuild": "^0.25.0",
    "sharp": "^0.34.0"
  }
}
